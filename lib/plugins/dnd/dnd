#!/usr/bin/env bash

# Focus (Do Not Disturb) helper. It never writes preferences or restarts services.
#
#   dnd status   print the Focus state as JSON, read from the Focus assertions file
#   dnd toggle   run the Shortcuts shortcut named in GAUDI_DND_SHORTCUT, if any

ASSERTIONS_FILE="${GAUDI_DND_ASSERTIONS_FILE:-$HOME/Library/DoNotDisturb/DB/Assertions.json}"
SHORTCUT="${GAUDI_DND_SHORTCUT:-}"

print_status() {
  local status="unknown" mode="" shortcut="false" assertions

  # The file is absent on old macOS and unreadable without Full Disk Access.
  if assertions=$(plutil -extract data json -o - "$ASSERTIONS_FILE" 2>/dev/null); then
    if [[ "$assertions" =~ \"assertionDetailsModeIdentifier\":\"([A-Za-z0-9._-]+)\" ]]; then
      status="on"
      mode="${BASH_REMATCH[1]##*.}"
    else
      status="off"
    fi
  fi

  if [[ -n "$SHORTCUT" ]]; then shortcut="true"; fi

  printf '{"status":"%s","mode":"%s","shortcut":%s}\n' "$status" "$mode" "$shortcut"
}

toggle() {
  if [[ -z "$SHORTCUT" ]] || ! command -v shortcuts >/dev/null 2>&1; then return 0; fi
  shortcuts run "$SHORTCUT"
}

case "${1:-status}" in
  status) print_status ;;
  toggle) toggle ;;
  *)
    printf 'Usage: %s [status|toggle]\n' "$(basename "$0")" >&2
    exit 1
    ;;
esac
