#!/usr/bin/env bash

# Nothing to show: the widget hides itself when there is no layout.
no_yabai() {
  printf '{"activeWindow":null,"layout":null}\n'
}

if command -v yabai >/dev/null 2>&1; then
  yabai_path=$(command -v yabai)
elif [[ -x /opt/homebrew/bin/yabai ]]; then
  yabai_path="/opt/homebrew/bin/yabai"
elif [[ -x /usr/local/bin/yabai ]]; then
  yabai_path="/usr/local/bin/yabai"
else
  # yabai is not installed.
  no_yabai
  exit 0
fi

# A failed query also covers "yabai is not running", so no separate process check.
if ! layout=$("$yabai_path" -m query --spaces --space 2>/dev/null) || [[ -z "$layout" ]]; then
  no_yabai
  exit 0
fi

# Fails when no window has focus (empty space), which is not an error.
current_window=$("$yabai_path" -m query --windows --window 2>/dev/null)
if [[ -z "$current_window" ]]; then
  current_window="null"
fi

printf '{"activeWindow":%s,"layout":%s}\n' "$current_window" "$layout"
